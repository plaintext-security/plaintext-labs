FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

# Running a Samba AD DC on Debian bookworm needs three pieces beyond `samba`
# (which ships samba-tool but, in slim, not the DC runtime):
#   - samba-ad-provision : the AD schema files `samba-tool domain provision` reads
#                          (without it: "Please install samba-ad-provision package").
#   - samba-dsdb-modules : the DC-side LDB modules (samba_secrets / samba_dsdb).
#                          (without it: "Module [samba_secrets] not found", no sam.ldb).
#   - samba-vfs-modules  : the VFS plugins, incl. acl_xattr.so that provisioning's
#                          sysvol ACL step (setsysvolacl) loads. Without it provision
#                          aborts ("Error loading module '...acl_xattr.so'"), leaving
#                          secrets.ldb incomplete so the DC can never start
#                          ("NT_STATUS_CANT_ACCESS_DOMAIN_INFO").
RUN apt-get update && apt-get install -y --no-install-recommends \
    samba \
    samba-dsdb-modules \
    samba-vfs-modules \
    samba-ad-provision \
    ldb-tools \
    krb5-user \
    winbind \
    libpam-winbind \
    libnss-winbind \
    dnsutils \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Remove existing samba config (package ships a stub)
RUN rm -f /etc/samba/smb.conf

COPY data/setup.sh /setup.sh
RUN chmod +x /setup.sh

EXPOSE 389 636 88 445 139 135

CMD ["/setup.sh"]
